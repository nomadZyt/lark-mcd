# 复制为 .env，只放在本机。不要提交 .env。
# 申请 Token：https://open.mcd.cn/mcp

MCD_MCP_TOKEN=
MCD_MODE=mock
MCD_MCP_URL=https://mcp.mcd.cn

FEISHU_APP_ID=
FEISHU_APP_SECRET=
OWNER_OPEN_ID=

# 只有写成 false 才会真正调用 create-order / cancel-order
DRY_RUN=true

# 可选。默认是 ~/.lark-mcd/state.json
STATE_PATH=

# Agent 入口。只有写成 1，lark-mcd agent 才会运行。
# 不要放进 cron、heartbeat、定时任务或后台任务。
# LARK_MCD_AGENT=1
